{
  "name": "drawnie",
  "productName": "Drawnie",
  "version": "0.1.0",
  "description": "Pizarra infinita para crear diagramas bonitos, con soporte para lápiz.",
  "main": "main.js",
  "author": {
    "name": "Jorge Juarez",
    "email": "contacto@jorgejuarez.net"
  },
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "i18n": "node scripts/i18n.mjs",
    "i18n:check": "node scripts/i18n.mjs --check",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.drawnie.app",
    "productName": "Drawnie",
    "copyright": "© 2026 Jorge Juarez",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "i18n.js",
      "locales/*.po",
      "src/**/*",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "fileAssociations": [
      {
        "ext": "drawnie",
        "name": "Drawnie Board",
        "description": "Pizarra de Drawnie",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "es_ES"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
